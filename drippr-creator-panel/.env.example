# Firebase Client (public by design)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── Firebase Admin (SERVER ONLY) ──
# RECOMMENDED: base64-encoded service account JSON. Paste-safe.
#   base64 -w0 serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Alternative 1: three separate variables
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Alternative 2: raw single-line JSON (fragile — smart quotes break it)
# FIREBASE_SERVICE_ACCOUNT_KEY=

# ── Admin access ──
ADMIN_UIDS=
VITE_ADMIN_UIDS=

# ── ImageKit ──
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
VITE_IMAGEKIT_PUBLIC_KEY=
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/YOUR_ID

# ── Shopify Admin API ──
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01
